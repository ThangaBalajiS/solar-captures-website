---
const stats = [
  { label: "CO2 Offset / KW", value: "1.3 Tons", sub: "Annually" },
  { label: "Trees Planted Eq.", value: "59", sub: "Per Year" },
  { label: "EB Bill Savings", value: "Up to 90%", sub: "Monthly" },
  { label: "Avg. Performance", value: "325%", sub: "Increase" },
];
---
<section class="py-24 bg-white border-y border-gray-100">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 md:gap-8">
      {stats.map(stat => (
        <div class="text-center group">
          <p class="text-4xl md:text-5xl font-serif mb-2 text-primary group-hover:text-accent transition-colors duration-500">
            {stat.value}
          </p>
          <p class="text-xs uppercase tracking-widest text-gray-500 font-medium mb-1">
            {stat.label}
          </p>
          <p class="text-xs text-gray-400 italic">
            {stat.sub}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
