---
const subsidies = [
  { range: "1KW to 2KW", amount: "₹30,000" },
  { range: "2KW to 3KW", amount: "₹60,000" },
  { range: "3KW to 10KW", amount: "₹78,000" },
];
---
<section id="subsidies" class="py-24 bg-[#F9F6F0] overflow-hidden relative border-b border-gray-200/50">
  <div class="absolute top-0 left-0 w-1/2 h-full bg-earth/50 -skew-x-12 -translate-x-1/2"></div>
  
  <div class="container mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/2">
        <span class="text-leaf uppercase tracking-widest text-sm font-semibold mb-4 inline-block bg-leaf/10 px-4 py-1.5 rounded-full">Government Approved</span>
        <h2 class="text-4xl md:text-5xl font-serif mb-6 leading-tight text-primary text-balance">Maximize Your Savings.</h2>
        <p class="text-gray-700 font-light leading-relaxed mb-8 max-w-lg text-lg">
          Switching to solar is a smart financial investment. Benefit from direct government subsidies and reduce your installation costs significantly.
        </p>
        <div class="flex items-center gap-4 text-sm text-gray-600 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
          <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="font-medium text-primary">Direct Credit to Bank Account within 30 days.</span>
        </div>
      </div>
      
      <div class="lg:w-1/2 w-full">
        <div class="space-y-4">
          {subsidies.map((sub, index) => (
            <div class={`${index === 2 ? 'bg-primary text-white shadow-xl scale-[1.02] ring-2 ring-primary/20' : 'bg-white text-primary border border-gray-200/60 shadow-sm'} p-8 rounded-3xl flex justify-between items-center transition-all duration-300`}>
              <span class="font-medium tracking-wide text-lg">{sub.range} System</span>
              <div class="text-right">
                <span class={`block text-xs uppercase tracking-widest mb-1 font-semibold ${index === 2 ? 'text-accent' : 'text-leaf'}`}>Subsidy Amount</span>
                <span class="text-3xl font-serif">{sub.amount}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
