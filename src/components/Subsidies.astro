---
const subsidies = [
  { range: "1KW to 2KW", amount: "₹30,000", bg: "bg-white" },
  { range: "2KW to 3KW", amount: "₹60,000", bg: "bg-white" },
  { range: "3KW to 10KW", amount: "₹78,000", bg: "bg-[#FFD700]/10" },
];
---
<section class="py-24 bg-[#1A1A1A] text-white overflow-hidden relative">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-[#FFD700]/5 -skew-x-12 translate-x-1/2"></div>
  
  <div class="container mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/2">
        <span class="text-[#FFD700] uppercase tracking-widest text-sm font-medium mb-4 inline-block">MNRE Government Approved</span>
        <h2 class="text-4xl md:text-5xl font-serif mb-6 leading-tight text-white">Maximize Your <br /> Savings.</h2>
        <p class="text-gray-400 font-light leading-relaxed mb-8 max-w-lg">
          Switching to solar is not just an environmental choice—it's a smart financial investment. Benefit from direct government subsidies and reduce your installation costs significantly.
        </p>
        <div class="flex items-center gap-4 text-sm text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Direct Credit to Bank Account within 30 days.
        </div>
      </div>
      
      <div class="lg:w-1/2 w-full">
        <div class="space-y-4">
          {subsidies.map((sub, index) => (
            <div class={`${sub.bg} p-8 rounded-sm flex justify-between items-center group hover:scale-[1.02] transition-transform duration-300`}>
              <span class={`${index === 2 ? 'text-[#FFD700]' : 'text-[#1A1A1A]'} font-medium tracking-wide`}>{sub.range} System</span>
              <div class="text-right">
                <span class={`block text-xs uppercase tracking-tighter mb-1 font-semibold ${index === 2 ? 'text-[#FFD700]/70' : 'text-gray-500'}`}>Subsidy Amount</span>
                <span class={`text-3xl font-serif ${index === 2 ? 'text-[#FFD700]' : 'text-[#1A1A1A]'}`}>{sub.amount}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
