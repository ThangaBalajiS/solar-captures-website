---
const testimonials = [
  {
    quote: "Solar Captures exceeded my expectations. Their attention to detail and commitment to sustainable energy are truly remarkable.",
    author: "Arun Kumar",
    location: "Chennai"
  },
  {
    quote: "Working with Solar Captures was a seamless experience. They ensured every aspect of the project was handled with engineering precision.",
    author: "Priya Lakshmi",
    location: "Kanchipuram"
  },
  {
    quote: "Professional and dedicated team. I couldn't be happier with the hybrid solutions they provided for my home.",
    author: "Ramesh Babu",
    location: "Chennai"
  }
];
---
<section class="py-24 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif text-primary mb-4">Trusted by 500+ <br class="md:hidden" /> Families</h2>
      <div class="w-16 h-1 bg-accent mx-auto"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-12">
      {testimonials.map(t => (
        <div class="relative pt-12">
          <svg class="absolute top-0 left-0 h-12 w-12 text-accent/20" fill="currentColor" viewBox="0 0 32 32">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
          </svg>
          <blockquote class="relative">
            <p class="text-gray-600 font-light italic leading-relaxed mb-6">
              "{t.quote}"
            </p>
            <footer class="flex items-center gap-4">
              <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center text-primary font-serif">
                {t.author[0]}
              </div>
              <div>
                <cite class="not-italic font-medium text-primary block text-sm">{t.author}</cite>
                <span class="text-xs text-gray-400 uppercase tracking-widest">{t.location}</span>
              </div>
            </footer>
          </blockquote>
        </div>
      ))}
    </div>
  </div>
</section>
