---
---
<header id="main-header" class="fixed w-full z-50 transition-all duration-500 py-6 border-b border-transparent">
  <div class="container mx-auto px-6 flex justify-between items-center">
    <a href="/" class="transition-opacity duration-300 hover:opacity-80 flex items-center gap-3" id="logo">
      <img src="/Solar captures logo.jpg" alt="Solar Captures Logo" class="h-10 w-auto bg-white p-1 rounded-lg shadow-sm" />
      <span class="text-xl font-serif text-primary hidden sm:block tracking-tight" id="logo-text">Solar Captures</span>
    </a>
    
    <nav class="hidden md:flex items-center gap-10">
      <a href="#services" class="text-sm font-medium text-gray-700 hover:text-accent transition-colors">Services</a>
      <a href="#about" class="text-sm font-medium text-gray-700 hover:text-accent transition-colors">About</a>
      <a href="#faq" class="text-sm font-medium text-gray-700 hover:text-accent transition-colors">FAQ</a>
      <a href="#subsidies" class="px-6 py-2.5 bg-accent text-primary text-sm font-semibold rounded-full shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:shadow-[0_0_30px_rgba(245,158,11,0.5)] hover:-translate-y-0.5 transition-all duration-300">
        Calculate Savings
      </a>
    </nav>

    <button class="md:hidden text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-white/90', 'backdrop-blur-lg', 'shadow-sm', 'py-4', 'border-gray-200/50');
      header?.classList.remove('py-6', 'border-transparent');
    } else {
      header?.classList.remove('bg-white/90', 'backdrop-blur-lg', 'shadow-sm', 'py-4', 'border-gray-200/50');
      header?.classList.add('py-6', 'border-transparent');
    }
  });
</script>