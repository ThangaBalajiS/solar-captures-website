---
const year = new Date().getFullYear();
---
<footer class="bg-primary text-white pt-24 pb-12 border-t border-white/5">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-12 gap-12 mb-20">
      <div class="col-span-1 md:col-span-5 pr-0 md:pr-12">
        <a href="./" class="flex items-center gap-4 mb-8">
          <img src="Solar captures logo.jpg" alt="Solar Captures Logo" class="h-12 w-auto bg-white p-1.5 rounded-sm" />
          <h2 class="text-3xl font-serif text-white tracking-tight">Solar Captures</h2>
        </a>
        <p class="text-white/60 font-light leading-relaxed max-w-sm mb-10">
          Preserving our planet by providing green and sustainable energy solutions for a brighter future. Chennai's leading solar installation experts.
        </p>
        <div class="flex gap-4">
          <a href="#" class="w-11 h-11 border border-white/10 flex items-center justify-center rounded-full hover:border-accent hover:text-accent hover:bg-white/5 transition-all duration-300 text-white/80 group">
            <span class="sr-only">Facebook</span>
            <svg class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-8.74h-2.94v-3.403h2.94v-2.511c0-2.91 1.777-4.493 4.371-4.493 1.242 0 2.311.092 2.622.134v3.04l-1.799.001c-1.412 0-1.686.672-1.686 1.655v2.174h3.366l-.438 3.403h-2.928v8.74h6.052c.733 0 1.325-.593 1.325-1.325v-21.35c0-.732-.592-1.325-1.325-1.325z"/></svg>
          </a>
          <a href="#" class="w-11 h-11 border border-white/10 flex items-center justify-center rounded-full hover:border-accent hover:text-accent hover:bg-white/5 transition-all duration-300 text-white/80 group">
            <span class="sr-only">WhatsApp</span>
            <svg class="h-5 w-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.246 2.248 3.484 5.232 3.484 8.412-.003 6.557-5.338 11.892-11.893 11.892-1.997-.001-3.951-.5-5.688-1.448l-6.309 1.656zm6.224-3.52c1.54.914 3.51 1.403 5.673 1.404 5.663 0 10.27-4.607 10.273-10.273 0-2.745-1.07-5.326-3.012-7.27-1.942-1.944-4.524-3.013-7.265-3.014-5.662 0-10.27 4.608-10.273 10.274-.001 1.83.477 3.616 1.383 5.176l-.924 3.376 3.461-.907z"/></svg>
          </a>
        </div>
      </div>

      <div class="col-span-1 md:col-span-4">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-8 text-accent">Contact Us</h3>
        <ul class="space-y-5 text-sm text-white/70 font-light">
          <li class="flex items-start gap-4 group cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent/70 shrink-0 group-hover:text-accent transition-colors mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="group-hover:text-white transition-colors">Chennai, Tamil Nadu</span>
          </li>
          <li class="flex items-start gap-4 group cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent/70 shrink-0 group-hover:text-accent transition-colors mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="group-hover:text-white transition-colors">+91 84891 11511<br />+044 2999 3999</span>
          </li>
          <li class="flex items-start gap-4 group cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent/70 shrink-0 group-hover:text-accent transition-colors mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="group-hover:text-white transition-colors">admin@solarcaptures.com</span>
          </li>
        </ul>
      </div>

      <div class="col-span-1 md:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-8 text-accent">Quick Links</h3>
        <ul class="space-y-4 text-sm text-white/70 font-light">
          <li><a href="#services" class="hover:text-white hover:translate-x-1 inline-block transition-all">Our Services</a></li>
          <li><a href="#about" class="hover:text-white hover:translate-x-1 inline-block transition-all">About Us</a></li>
          <li><a href="#" class="hover:text-white hover:translate-x-1 inline-block transition-all">Project Gallery</a></li>
          <li><a href="#faq" class="hover:text-white hover:translate-x-1 inline-block transition-all">FAQ</a></li>
          <li><a href="#" class="hover:text-white hover:translate-x-1 inline-block transition-all">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] text-white/40 uppercase tracking-widest font-medium">
      <p>&copy; {year} Solar Captures. All Rights Reserved.</p>
      <p>Engineering Solar for a Greener Tomorrow.</p>
    </div>
  </div>
</footer>
