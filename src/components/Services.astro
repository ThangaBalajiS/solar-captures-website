---
const services = [
  {
    title: "On-Grid Solar",
    description: "The most popular choice for urban homes. Reduce your EB bills by feeding excess power back to the grid.",
    features: ["Net Metering", "Zero Maintenance", "Highest ROI"]
  },
  {
    title: "Off-Grid Solar",
    description: "Complete energy independence. Perfect for remote locations or areas with frequent power cuts.",
    features: ["Battery Backup", "Total Control", "Reliable Power"]
  },
  {
    title: "Hybrid Solar",
    description: "The best of both worlds. Grid connectivity combined with smart battery backup for ultimate peace of mind.",
    features: ["Smart Monitoring", "Uninterrupted Supply", "Grid Resilient"]
  }
];
---
<section id="services" class="py-24 bg-earth">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mb-16">
      <h2 class="text-4xl md:text-5xl font-serif mb-6 text-primary">Tailored Energy <br /> Solutions</h2>
      <p class="text-gray-600 font-light leading-relaxed text-lg">
        At Solar Captures, we empower customers to create their own clean, reliable power using high-performance panels and expertly engineered systems.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 relative z-10">
      {services.map((service, index) => (
        <div class={`p-10 bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgb(0,0,0,0.08)] hover:-translate-y-2 transition-all duration-500 flex flex-col border border-gray-100/50 ${index === 2 ? 'ring-2 ring-accent/30' : ''}`}>
          <div class="w-12 h-12 rounded-full bg-primary/5 flex items-center justify-center mb-6 text-primary">
            {index === 0 && <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>}
            {index === 1 && <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
            {index === 2 && <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>}
          </div>
          <h3 class="text-2xl font-serif mb-4 text-primary tracking-tight">{service.title}</h3>
          <p class="text-gray-500 font-light mb-8 flex-grow leading-relaxed text-sm">
            {service.description}
          </p>
          <ul class="space-y-3 mb-8 bg-gray-50/50 p-4 rounded-xl">
            {service.features.map(feature => (
              <li class="flex items-center text-xs text-gray-500 font-medium">
                <svg class="w-4 h-4 text-accent mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#" class="inline-flex items-center text-sm font-semibold text-primary hover:text-accent transition-colors group mt-auto">
            Learn More
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
