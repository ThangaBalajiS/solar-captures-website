---
const services = [
  {
    title: "On-Grid Solar",
    description: "The most popular choice for urban homes. Reduce your EB bills by feeding excess power back to the grid.",
    features: ["Net Metering", "Zero Maintenance", "Highest ROI"]
  },
  {
    title: "Off-Grid Solar",
    description: "Complete energy independence. Perfect for remote locations or areas with frequent power cuts.",
    features: ["Battery Backup", "Total Control", "Reliable Power"]
  },
  {
    title: "Hybrid Solar",
    description: "The best of both worlds. Grid connectivity combined with smart battery backup for ultimate peace of mind.",
    features: ["Smart Monitoring", "Uninterrupted Supply", "Grid Resilient"]
  }
];
---
<section id="services" class="py-24 bg-[#FCFCFC]">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mb-16">
      <h2 class="text-4xl md:text-5xl font-serif mb-6 text-primary">Tailored Energy <br /> Solutions</h2>
      <p class="text-gray-600 font-light leading-relaxed">
        At Solar Captures, we empower customers to create their own clean, reliable power using high-performance panels and expertly engineered systems.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div class={`p-10 border border-gray-100 bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-500 flex flex-col ${index === 2 ? 'border-accent/20' : ''}`}>
          <h3 class="text-2xl font-serif mb-4 text-primary">{service.title}</h3>
          <p class="text-gray-500 font-light mb-8 flex-grow leading-relaxed text-sm">
            {service.description}
          </p>
          <ul class="space-y-3 mb-8">
            {service.features.map(feature => (
              <li class="flex items-center text-xs text-gray-400 uppercase tracking-wider">
                <span class="w-1.5 h-1.5 bg-accent rounded-full mr-3"></span>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#" class="inline-flex items-center text-sm font-semibold text-primary hover:text-accent transition-colors">
            Learn More
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
