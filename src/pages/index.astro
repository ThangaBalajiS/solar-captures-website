---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import Subsidies from '../components/Subsidies.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Solar Captures | Modern Solar Energy Solutions in Chennai">
	<Header />
	<main>
		<Hero />
		<Subsidies />
		<Stats />
		<Services />
		<section id="about" class="py-24 bg-earth overflow-hidden">
			<div class="container mx-auto px-6">
				<div class="flex flex-col md:flex-row items-center gap-16">
					<div class="md:w-1/2">
						<div class="relative rounded-3xl overflow-hidden shadow-2xl border border-gray-200/50 group">
							<img 
								src="/brighter-future.png" 
								alt="Solar Panel Engineering" 
								class="object-cover w-full h-full min-h-[400px] scale-105 transition-transform duration-700 group-hover:scale-110"
							/>
							<div class="absolute -bottom-6 -right-6 bg-[#F3EFE6] p-8 rounded-3xl shadow-2xl z-10 hidden md:block border border-gray-200/50">
								<p class="text-primary font-serif text-4xl mb-1 font-bold">MNRE</p>
								<p class="text-primary text-xs uppercase tracking-widest font-bold">Approved Partner</p>
							</div>
						</div>
					</div>
					<div class="md:w-1/2">
						<span class="text-accent uppercase tracking-widest text-sm font-medium mb-4 inline-block">Our Story</span>
						<h2 class="text-4xl md:text-5xl font-serif mb-6 text-primary leading-tight text-balance">Engineering a Brighter Future.</h2>
						<p class="text-gray-700 font-light leading-relaxed mb-6 text-lg">
							At Solar Captures, we specialize in high-performance hybrid solar solutions. Our mission is simple: to help you generate your own power while significantly reducing your environmental footprint.
						</p>
						<p class="text-gray-600 font-light leading-relaxed mb-8">
							With years of experience in the Chennai market, our team of certified professionals ensures every installation is tailored to your specific energy needs and property layout.
						</p>
						<a href="#contact" class="inline-flex items-center text-sm font-semibold text-leaf hover:text-primary transition-colors group">
							Read More About Us
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>
		<Testimonials />
		<section id="faq" class="bg-earth/50">
			<FAQ />
		</section>
		<section id="contact" class="py-24 bg-earth">
			<div class="container mx-auto px-6">
				<div class="bg-primary rounded-3xl p-12 md:p-20 relative overflow-hidden shadow-2xl">
					<div class="absolute top-0 right-0 w-64 h-64 bg-accent/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
					<div class="absolute bottom-0 left-0 w-64 h-64 bg-leaf/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
					<div class="relative z-10 flex flex-col lg:flex-row justify-between items-center gap-12">
						<div class="lg:w-2/3">
							<h2 class="text-4xl md:text-5xl font-serif text-white mb-6 text-balance">Ready to generate your own power?</h2>
							<p class="text-gray-300 font-light max-w-lg text-lg">
								Get a free site survey and a customized solar quote for your home or business today. No obligations, just expert advice.
							</p>
						</div>
						<div class="lg:w-1/3 flex flex-col sm:flex-row gap-4 w-full">
							<a href="tel:+918489111511" class="px-8 py-4 bg-accent text-primary font-semibold rounded-2xl text-center hover:bg-white transition-colors flex-1 shadow-lg">
								Call Us Now
							</a>
							<a href="https://wa.me/918489111511" class="px-8 py-4 bg-white/10 backdrop-blur border border-white/20 text-white font-semibold rounded-2xl text-center hover:bg-white hover:text-primary transition-colors flex-1">
								WhatsApp
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
